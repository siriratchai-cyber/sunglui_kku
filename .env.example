# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของคุณเอง (ไฟล์ .env ห้าม commit ขึ้น GitHub เด็ดขาด)

# ---------- Supabase (ฐานข้อมูล) ----------
# หาได้จาก Supabase Dashboard > Project Settings > API
# ใช้ "service_role" key เท่านั้น (secret! ห้ามเอาไปใส่ฝั่ง frontend)
#SUPABASE_URL=https:
#SUPABASE_SERVICE_ROLE_KEY=

# ---------- Firebase Admin (ตรวจสอบผู้ใช้ที่ล็อกอิน) ----------
# หาได้จาก Firebase Console > Project settings (รูปเฟือง) > Service accounts
# > Generate new private key (จะได้ไฟล์ .json มา 1 ไฟล์ เอาค่า 3 ตัวนี้มาใส่)
#FIREBASE_PROJECT_ID=sungluikku
#FIREBASE_CLIENT_EMAIL=
#FIREBASE_PRIVATE_KEY="
#PORT=3000
